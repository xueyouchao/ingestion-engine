    {
      "dot": "violet",
      "title": "Two cleanup regimes",
      "items": [
        "Docling branch: boilerplate tags, page numbers, malformed tables, image annotations",
        "OCR branch: failed pages dropped, repeated lines and sentences, boilerplate",
        "Both branches then run shared normalisation with ftfy and spacing repair"
      ]
    },
    {
      "dot": "amber",
      "title": "Where the thresholds come from",
      "items": [
        "GlotLID runs per page, then scores are averaged and compared to a threshold table",
        "Thresholds were tuned against gemma-3-27b-it labels on 20k samples per language",
        "Tuning maximised F-beta with beta 0.1, heavily favouring precision"
      ]
    },
    {
      "dot": "rose",
      "title": "Two dedup rounds bracket the filter",
      "items": [
        "Exact dedup on PDF bytes runs before extraction, in the ingest half",
        "Exact dedup on normalised text runs after language selection",
        "MinHash near-duplicate removal runs last, right before packaging"
      ]
    }
