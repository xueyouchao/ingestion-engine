#!/usr/bin/env python3
"""A local stand-in for `paddleocr doc_parser`, so a scan can be read on a machine with no GPU.

It accepts the exact command line the paddleocr-vl CLI engine builds:

    <this> doc_parser -i <pages-dir> --pipeline_version <v> --save_path <out-dir>

and writes one ``*_res.json`` per page in the shape ``page_from_paddle_result`` reads. The OCR is real
tesseract, not the deployed PaddleOCR-VL model, so the text this prints is tesseract's reading of the
page -- useful for proving the lane end to end, never evidence of what the demo's model returns.

Wired in with:

    FINEPDFS_ENGINE=paddleocr-vl FINEPDFS_ENGINE_COMMAND=/path/to/this

The demo's own deploy uses it (``deploy/demo/finepdfs-live-demo.service``) because this VPS has no GPU and
the Modal worker app is not deployed: the site then reads a scan with tesseract, and the Engine Identity
on the page names this command, so a reader can see whose text they are looking at. When the Modal worker
is deployed, point ``FINEPDFS_ENGINE_BASE_URL``/``FINEPDFS_ENGINE_API_KEY`` at it instead and drop this.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# The engine's own bound around this command (``FINEPDFS_ENGINE_TIMEOUT``, 120s in the unit). A page's
# budget is a share of it, so this shim fails the read with its own message before that bound kills it.
ENGINE_TIMEOUT = "FINEPDFS_ENGINE_TIMEOUT"
DEFAULT_ENGINE_TIMEOUT = 120.0


def _engine_bound() -> float:
    """The bound the engine holds around this command, as ``FINEPDFS_ENGINE_TIMEOUT`` sets it."""
    raw = os.environ.get(ENGINE_TIMEOUT, "").strip()
    try:
        return float(raw) if raw else DEFAULT_ENGINE_TIMEOUT
    except ValueError:
        return DEFAULT_ENGINE_TIMEOUT


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("mode", nargs="?")
    parser.add_argument("-i", "--input", dest="images", required=True)
    # Consumed only so the engine's argument list parses; this shim has one behaviour, and the version a
    # read reports is the Engine Identity's, not this argument's.
    parser.add_argument("--pipeline_version", default="v1")
    parser.add_argument("--save_path", dest="output", required=True)
    parser.add_argument("-l", "--lang", default="eng")
    parser.add_argument(
        "--timeout",
        type=float,
        default=None,
        help="seconds a single page may take; default is the engine's bound shared between the pages",
    )
    # Strict, not ``parse_known_args``: this shim stands in for the engine's own command, so a flag the
    # engine learns to send must fail here loudly instead of being swallowed while the output shape drifts.
    try:
        options = parser.parse_args(argv)
    except SystemExit:
        print(f"the engine passes flags this shim does not know: {argv}", file=sys.stderr)
        return 2

    if options.mode != "doc_parser":
        # The engine calls ``doc_parser``; answering any other invocation would dress an unknown request
        # up as a successful read, which is worse than failing it. Checked before the tooling, because
        # this contract does not depend on what the host has installed.
        print(f"unknown subcommand {options.mode!r}; this shim answers doc_parser", file=sys.stderr)
        return 2

    if shutil.which("tesseract") is None:
        # The runner quotes this as the read's failure reason, so it says what is missing rather than
        # ending in a traceback that reaches the page.
        print("tesseract is not installed or not on PATH", file=sys.stderr)
        return 1

    images = sorted(Path(options.images).glob("*.png"))
    output = Path(options.output)
    output.mkdir(parents=True, exist_ok=True)
    if not images:
        print(f"no page images under {options.images}", file=sys.stderr)
        return 1

    budget = options.timeout if options.timeout is not None else _engine_bound() / len(images)
    if budget <= 0:
        print(f"no time left for any page: {ENGINE_TIMEOUT}={_engine_bound():g}s", file=sys.stderr)
        return 1

    for index, image in enumerate(images):
        try:
            result = subprocess.run(
                ["tesseract", str(image), "-", "-l", options.lang],
                capture_output=True,
                # Tesseract writes UTF-8; decoding with the host's locale would raise on exactly the
                # non-ASCII text this lane exists for.
                encoding="utf-8",
                errors="replace",
                check=False,
                # The engine's own bound kills this process, not the tesseract it spawned; a hung page
                # would keep burning a core here. Bounded per page, it fails the read instead.
                timeout=budget,
            )
        except subprocess.TimeoutExpired:
            print(f"tesseract did not finish {image.name} within {budget:g}s", file=sys.stderr)
            return 1
        except OSError as error:
            print(f"tesseract could not run: {error}", file=sys.stderr)
            return 1
        if result.returncode != 0:
            print(f"tesseract failed on {image}: {result.stderr.strip()}", file=sys.stderr)
            return 1
        text = result.stdout.strip()
        # The shape ``page_from_paddle_result`` reads. Provenance is not carried here: the Engine
        # Identity the page shows already names the command, and a field no consumer reads is a promise
        # with nothing behind it.
        payload = {
            "res": {
                "page_index": index,
                "parsing_res_list": [{"block_content": text, "block_label": "text", "block_order": 0}]
                if text
                else [],
            }
        }
        (output / f"{image.stem}_res.json").write_text(json.dumps(payload), encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
