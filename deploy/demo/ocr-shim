#!/usr/bin/env python3
"""A local stand-in for `paddleocr doc_parser`, so a scan can be read on a machine with no GPU.

It accepts the exact command line the paddleocr-vl CLI engine builds:

    <this> doc_parser -i <pages-dir> --pipeline_version <v> --save_path <out-dir>

and writes one ``*_res.json`` per page in the shape ``page_from_paddle_result`` reads. The OCR is real
tesseract, not the deployed PaddleOCR-VL model, so the text this prints is tesseract's reading of the
page -- useful for proving the lane end to end, never evidence of what the demo's model returns.

Wired in with:

    FINEPDFS_ENGINE=paddleocr-vl FINEPDFS_ENGINE_COMMAND=/path/to/this

The demo's own deploy uses it (``deploy/demo/finepdfs-live-demo.service``) because this VPS has no GPU and
the Modal worker app is not deployed: the site then reads a scan with tesseract, and the Engine Identity
on the page names this command, so a reader can see whose text they are looking at. When the Modal worker
is deployed, point ``FINEPDFS_ENGINE_BASE_URL``/``FINEPDFS_ENGINE_API_KEY`` at it instead and drop this.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# The engine's own bound around this command: ``FINEPDFS_ENGINE_TIMEOUT``, whose absent default is
# ``environment.DEFAULT_TIMEOUT_SECONDS``. The read is budgeted inside it so this shim fails first, with the
# page named, instead of being killed by the runner. A test pins the default to the engine's own.
ENGINE_TIMEOUT = "FINEPDFS_ENGINE_TIMEOUT"
DEFAULT_ENGINE_TIMEOUT = 300.0
# The fraction of that bound this shim allows itself, so its message always arrives before the kill.
ENGINE_MARGIN = 0.9


class _UsageError(Exception):
    """A command line this shim cannot accept, in argparse's words."""


class _Parser(argparse.ArgumentParser):
    """An ArgumentParser that reports instead of exiting, so the shim can name what it refused."""

    def error(self, message: str) -> None:  # argparse's hook, not a public API
        """Refuse a command line, carrying argparse's own words up to ``main``."""

        raise _UsageError(message)


def _engine_bound() -> float:
    """The bound the engine holds around this command, as ``FINEPDFS_ENGINE_TIMEOUT`` configures it.

    An empty or unparsable variable is the engine's default. ``inf`` is a legitimate "no bound" -- there is
    then nothing to budget against, so this shim uses the default. A value that is neither (NaN, ``0``, a
    negative) comes back as it is and ``main`` refuses the read: the engine would hold an impossible bound,
    and a read the runner kills has no page to name.
    """
    raw = os.environ.get(ENGINE_TIMEOUT, "").strip()
    if not raw:
        return DEFAULT_ENGINE_TIMEOUT
    try:
        bound = float(raw)
    except ValueError:
        return DEFAULT_ENGINE_TIMEOUT
    return DEFAULT_ENGINE_TIMEOUT if bound == math.inf else bound


def main(argv: list[str]) -> int:
    parser = _Parser(add_help=False)
    parser.add_argument("mode", nargs="?")
    parser.add_argument("-i", "--input", dest="images", required=True)
    # Consumed only so the engine's argument list parses; this shim has one behaviour, and the version a
    # read reports is the Engine Identity's, not this argument's.
    parser.add_argument("--pipeline_version", default="v1")
    parser.add_argument("--save_path", dest="output", required=True)
    parser.add_argument("-l", "--lang", default="eng")
    parser.add_argument(
        "--timeout",
        type=float,
        default=None,
        help="seconds for the whole read; default is the engine's own bound",
    )
    # Strict, not ``parse_known_args``: this shim stands in for the engine's own command, so a flag the
    # engine learns to send must fail here loudly instead of being swallowed while the output shape drifts.
    # argparse's own words are kept -- they name the offending flag, which a generic message would not.
    try:
        options = parser.parse_args(argv)
    except _UsageError as error:
        print(f"this shim does not take that command line: {error}", file=sys.stderr)
        return 2

    if options.mode != "doc_parser":
        # The engine calls ``doc_parser``; answering any other invocation would dress an unknown request
        # up as a successful read, which is worse than failing it. Checked before the tooling, because
        # this contract does not depend on what the host has installed.
        print(f"unknown subcommand {options.mode!r}; this shim answers doc_parser", file=sys.stderr)
        return 2

    if shutil.which("tesseract") is None:
        # The runner quotes this as the read's failure reason, so it says what is missing rather than
        # ending in a traceback that reaches the page.
        print("tesseract is not installed or not on PATH", file=sys.stderr)
        return 1

    images = sorted(Path(options.images).glob("*.png"))
    output = Path(options.output)
    output.mkdir(parents=True, exist_ok=True)
    if not images:
        print(f"no page images under {options.images}", file=sys.stderr)
        return 1

    engine_bound = _engine_bound()
    # Both numbers are checked, not just the one that wins: ``min(30, nan)`` is 30, so an unusable engine
    # bound would otherwise pass a read the runner is about to kill.
    for budget_source, value in ((ENGINE_TIMEOUT, engine_bound), ("--timeout", options.timeout)):
        if value is None:
            continue
        if not math.isfinite(value) or value <= 0:
            print(f"no time to read anything: the budget from {budget_source} is {value:g}", file=sys.stderr)
            return 1
    requested = options.timeout if options.timeout is not None else engine_bound
    # Never past the engine's own bound: beyond it the runner kills this process before it can name the
    # page, which is the only reason to budget here at all.
    budget = min(requested, engine_bound)
    # A deadline rather than a share per page: a slow page may use what the fast ones left behind, and the
    # read still ends inside the engine's bound with this shim's own message.
    deadline = time.monotonic() + budget * ENGINE_MARGIN

    for index, image in enumerate(images):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            print(f"no time left for {image.name} (budget {budget:g}s)", file=sys.stderr)
            return 1
        try:
            result = subprocess.run(
                ["tesseract", str(image), "-", "-l", options.lang],
                capture_output=True,
                # Tesseract writes UTF-8; decoding with the host's locale would raise on exactly the
                # non-ASCII text this lane exists for.
                encoding="utf-8",
                errors="replace",
                check=False,
                # The engine's own bound kills this process, not the tesseract it spawned; a hung page
                # would keep burning a core here. Bounded per page, it fails the read instead.
                timeout=remaining,
            )
        except subprocess.TimeoutExpired:
            print(
                f"tesseract did not finish {image.name} within {remaining:g}s of its {budget:g}s budget",
                file=sys.stderr,
            )
            return 1
        except OSError as error:
            print(f"tesseract could not run: {error}", file=sys.stderr)
            return 1
        if result.returncode != 0:
            print(f"tesseract failed on {image}: {result.stderr.strip()}", file=sys.stderr)
            return 1
        text = result.stdout.strip()
        # The shape ``page_from_paddle_result`` reads. Provenance is not carried here: the Engine
        # Identity the page shows already names the command, and a field no consumer reads is a promise
        # with nothing behind it.
        payload = {
            "res": {
                "page_index": index,
                "parsing_res_list": [{"block_content": text, "block_label": "text", "block_order": 0}]
                if text
                else [],
            }
        }
        (output / f"{image.stem}_res.json").write_text(json.dumps(payload), encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
