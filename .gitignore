# Generated by a run. Anchored, so they cannot swallow a directory that happens to share a name:
# an unanchored "corpus/" silently ignored src/finepdfs/infrastructure/corpus/.
/corpus/
/out/
/cocoindex.db/
/cocoindex.db
# The demo command's isolated state: corpus, output and warm CocoIndex database. Persistent by design.
/.demo/
# A rented worker's lease: machine-local, may name a billing worker, never committed.
/.gpu-worker.json

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Scratch space and benchmark data, all regenerable
/tmp/
bench/venv/
bench/pdf_real/
bench/md_real/

# Local-only working notes: the PR draft and the ticket slices. Kept on disk on purpose, never committed.
/.scratch/
